<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.2]" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="EmbeddedData\candu6-two-group-diffusion-pack-v1.json"
                      LogicalName="ReactorSim.Core.Data.candu6-two-group-diffusion-pack-v1.json" />
    <EmbeddedResource Include="EmbeddedData\candu6-two-group-iqs-pack-v1.json"
                      LogicalName="ReactorSim.Core.Data.candu6-two-group-iqs-pack-v1.json" />
  </ItemGroup>
  <Target Name="CheckCanonicalDiffusionPack" BeforeTargets="BeforeBuild">
    <GetFileHash Files="$(MSBuildThisFileDirectory)..\..\data\packs\candu6-two-group-diffusion-pack-v1.json">
      <Output TaskParameter="Items" ItemName="CanonicalDiffusionPackHash" />
    </GetFileHash>
    <GetFileHash Files="$(MSBuildThisFileDirectory)EmbeddedData\candu6-two-group-diffusion-pack-v1.json">
      <Output TaskParameter="Items" ItemName="EmbeddedDiffusionPackHash" />
    </GetFileHash>
    <PropertyGroup>
      <CanonicalDiffusionHash>@(CanonicalDiffusionPackHash->'%(FileHash)')</CanonicalDiffusionHash>
      <EmbeddedDiffusionHash>@(EmbeddedDiffusionPackHash->'%(FileHash)')</EmbeddedDiffusionHash>
    </PropertyGroup>
    <Error Condition="'$(CanonicalDiffusionHash)' != '$(EmbeddedDiffusionHash)'"
           Text="Embedded diffusion pack differs from canonical data/packs. Run tools/Sync-PhysicsPacks.ps1 -Stage." />
  </Target>
</Project>
