{
  "name": "candu-playtest",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite . --configLoader runner",
    "build": "tsc -b && vite build . --configLoader runner",
    "build:pages": "npm run build -- --base /CRS/ --outDir dist-pages",
    "preview": "vite preview",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "benchmark": "node scripts/benchmark-wasm.mjs",
    "benchmark:xenon": "node scripts/benchmark-xenon.mjs",
    "benchmark:gpu": "node scripts/benchmark-gpu.mjs",
    "test:gpu": "node --test scripts/gpu-prototype.test.mjs"
  },
  "dependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright": "1.62.1"
  }
}
