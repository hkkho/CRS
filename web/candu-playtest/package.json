{
  "name": "candu-playtest",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite . --configLoader runner",
    "build": "tsc -b && vite build . --configLoader runner",
    "build:pages": "npm run build -- --base /CRS/ --outDir dist-pages",
    "preview": "vite preview",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest",
    "smoke": "node scripts/daily-acceptance-smoke.mjs",
    "smoke:legacy": "node scripts/smoke.mjs",
    "smoke:daily": "node scripts/daily-acceptance-smoke.mjs",
    "smoke:scales": "node scripts/display-scales-smoke.mjs",
    "smoke:saves": "node scripts/saves-smoke.mjs",
    "benchmark": "node scripts/benchmark-wasm.mjs",
    "benchmark:xenon": "node scripts/benchmark-xenon.mjs",
    "smoke:accessibility": "node scripts/accessibility-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jsdom": "^26.1.0",
    "playwright": "1.62.1",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
